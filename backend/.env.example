# Copy to backend/.env; use your real service credentials locally only.
TIGER_DATA_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Question-selection model (RAG layer). Groq for now -- will switch to Gemini
# later; both implement the same interface (app/dialogue/selector_core.py).
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional, dedicated TimescaleDB database for API integration tests.
# Tests create/drop their own isolated schema; never point at a shared production DB.
TEST_TIGER_DATA_URL=

# Optional local-only speech recognition (Python 3.11 + requirements-asr.txt).
# Requires an already-cached ~/.cache/whisper/base.pt; runtime never downloads.
CADENCE_ASR_ENABLED=false
CADENCE_WHISPER_MODEL=base
# Maximum questions per ordinary check-in, including the initial question.
# Ending at this budget preserves uncertainty; it does not imply resolution.
CADENCE_MAX_QUESTIONS=4
